<template>
  <!-- 480 档详情页（S5 真机 480×480，多屏基档）：
       多屏差异由 media query 分档处理（circle480 基档 / S3 circle466 / RW5-6 rect432 / 8·9·10Pro rect336，
       见 style 文末「屏幕分档覆盖规则」；档内 px 按 designWidth=480 对屏宽等比缩放，档内数值为设计值）； -->
  <div class="page{{leaving ? ' page-leaving' : ''}}">
    <!-- 顶部时钟：置顶忽略安全区（clock-bar y∈[0,48]），HH:mm 每 10 秒刷新；
         返回键：白色大箭头「‹」+ 品牌标题组合整体水平居中（back-bar y∈[48,92]，安全区内，返回键不再孤悬左上角）（品牌图标 + 品牌名，图标预留后续实现，本次仅品牌名文字）；
         二维码：白色圆角容器 .qr-base（border-radius 12px 常显占位）+ 直角白底 qrcode 缩小嵌套居中（circle 码 228/rect 码 204，白边 14/14px，码角不被圆角切到；默认视图码底与悬浮按钮顶重叠 circle 25px/rect 1px，用户已知情）；
         qrcode 组件不支持 border-radius（真机两次验证：16px 与照抄参考仓库 12px 均无圆角），圆角由 div 容器保证；
         qrcode 加 if 待数据就绪渲染，容器常显缓解双码闪烁；stack+transparent 曾致不渲染，勿用；
         页面动画：进入动画页面渲染即播（page-in 右滑 48px + 淡入 0.25s ease-out），
         无隐藏等待期、无黑屏；二维码容器与码随页面整体动画直接一起出现，无独立淡入动画；
         原「先隐藏等待组件加载」机制已回退（曾导致黑屏）；
         退出时 onBack 置 leaving 叠加 .page-leaving 重播 page-out（反向 0.22s ease-in），
         定时器 220ms 后 router.back()（与动画 0.22s 对应）；页面返回按钮与系统返回手势/按键均走退出动画（onBackPress 拦截后复用） -->
    <div class="clock-bar">
      <text class="top-time">{{ clockText }}</text>
    </div>
    <!-- 手环/方表：‹ 圆形字符返回按钮 + 标题左置（见下方 nav-bar 单行导航），rect 档显示、圆表隐藏 -->
    <div class="back-bar">
      <text class="back-btn" onclick="onBack">‹</text>
      <text class="brand-title" onclick="onBack" if="{{brandName}}">{{ brandName }}</text>
    </div>

    <!-- 手环/方表单行导航（手表排版）：左上角返回按钮+标题、右上角时间；
         圆表仍用上方两行布局（clock-bar / back-bar） -->
    <div class="nav-bar">
      <div class="nav-left">
        <text class="nav-back" onclick="onBack">‹</text>
        <text class="nav-title" onclick="onBack">{{ brandName }}</text>
      </div>
      <text class="nav-time">{{ clockText }}</text>
    </div>

    <!-- 无二维码数据兜底 -->
    <div if="{{noQr}}" class="no-qr">
      <text class="no-qr-main">无二维码数据</text>
      <text class="no-qr-sub">该订单未识别到二维码</text>
    </div>

    <!-- 有二维码：滚动内容（内容超一屏时可滚），从上到下居中：
         取餐码小字标签 → 大号取餐码 → 二维码（白色圆角容器 .qr-base（border-radius 12px 常显占位）+ 直角白底 qrcode 缩小嵌套居中（circle 码 228/rect 码 204，白边 14/14px，码角不被圆角切到）；qrcode 组件不支持 border-radius（真机两次验证：16px 与照抄参考仓库 12px 均无圆角），圆角由 div 容器保证；qrcode 加 if 待数据就绪渲染，容器常显缓解双码闪烁；stack+transparent 曾致不渲染，勿用） → 订单时间（「已完成」按钮已移出 scroll，悬浮固定底部；scroll padding-bottom 96px 保留按钮占位空间，滚到底时间上移、与按钮间距 7px） -->
    <scroll if="{{!noQr}}" class="scroll" scroll-y="true">
      <div class="content">
        <text class="code-label">取餐码</text>
        <text class="code">{{ code }}</text>
        <div class="qr-wrap">
          <div class="qr-base" onclick="onQrClick">
            <qrcode if="{{qrData}}" class="qr" value="{{qrData}}"></qrcode>
          </div>
        </div>
        <text class="time" if="{{createdAtText}}">{{ createdAtText }}</text>
      </div>
    </scroll>

    <!-- 已完成按钮：悬浮固定底部中间（不随滚动内容滚动；全屏层覆盖其上） -->
    <div class="btn-wrap">
      <div class="done-btn" onclick="onMarkCompleted">
        <text class="done-text">已完成</text>
      </div>
    </div>

    <!-- 全屏二维码：点击二维码进入，点击任意处关闭；黑色背景覆盖整屏，居中白底圆角大容器 -->
    <div if="{{fullscreenQr}}" class="qr-fullscreen" onclick="onFullscreenClose">
      <div class="qr-full-base">
        <qrcode class="qr-full" value="{{qrData}}"></qrcode>
      </div>
    </div>
  </div>
</template>

<style>
.page {
  position: relative; /* 作为 .qr-fullscreen 绝对定位层的包含块（left/right/top/bottom: 0 覆盖整屏） */
  flex-direction: column;
  width: 100%;
  height: 100%;
  background-color: #000000;
  padding: 0px 36px 0px 36px;
  /* 进入动画页面渲染即播，无隐藏等待（原「先隐藏等组件加载」机制已回退，曾导致黑屏）；
     动画结束后回静态 opacity 1（默认），无黑屏、无回弹；
     Vela 无 animation-fill-mode 亦无碍；退出动画（.page-leaving）不受影响 */
  animation-name: page-in;
  animation-duration: 0.25s;
  animation-timing-function: ease-out;
}

/* 退出动画：onBack 置 leaving=true 时叠加本类，切换 animation-name 重播退出动画
   （反向右滑 48px + 淡出，0.22s ease-in；与 onBack 中 220ms 延迟返回的定时器时长对应）；
   静态 opacity: 1 防止退出动画起播前的首帧闪黑（动画期间 opacity 由 keyframes 覆盖生效） */
.page-leaving {
  opacity: 1;
  animation-name: page-out;
  animation-duration: 0.22s;
  animation-timing-function: ease-in;
}

/* 顶部安全区：圆屏(shape:circle) 顶部 padding 归零，时钟条置顶忽略安全区（y∈[0,48]），
   返回键条 y∈[48,92] 留在安全区内；S3(233dp)/S5(240dp) 两圆屏等比缩放后几何同时安全，
   circle 档位不拆分（码尺寸差异见文末 circle 覆盖块） */
@media (shape: circle) {
  .page {
    padding: 0px 36px 0px 36px;
  }
}

/* 矩形屏档位（RW5/6 216dp、8/9/10Pro 168dp）：见文末「屏幕分档覆盖规则」块 */

/* 480 档字号说明（本页为 480x480 基档，= S5 真机档；其余档位见文末分档块）：
   manifest designWidth=480：px 按屏幕物理宽等比缩放，基档 480×480 屏系数 ×1.000（下述数值均为设计值）；
   本档各字号即原大屏字号档值（top-time 26、back-btn 40、
   brand-title 34、code-label 22、code 36、time 22、done-text 26），
   行高容器（line-height/height）保持原大屏档兼容关系：
   .top-time 26px < line-height 48 ✓、箭头 40px 字在 line-height 44（余 4px，为该行高极限）、
   标题 34px 字在 line-height 44、22px 字在 26/28 行高、36px 字在 height/line-height 46、
   .done-text 26px < line-height 44 ✓ 均不溢出；
    （其余档位 S3 ×0.971 / RW5-6 ×0.900 / 8·9·10Pro ×0.700 的字号见文末分档块）*/

/* 顶部时钟条：y∈[0,48] 置顶，忽略安全区；时钟文字水平垂直居中 */
.clock-bar {
  flex-direction: row;
  justify-content: center;
  align-items: center;
  height: 48px;
}
/* 返回键条：y∈[48,92]，留在安全区内；返回箭头 + 品牌标题组合整体水平居中（justify-content: center），
   返回键不再孤悬左上角；.back-btn/.brand-title 均为 height 44px + line-height 44px 等高盒，
   align-items: center 垂直居中对齐（箭头与标题高低不齐已解决）；position: relative 保留（页面内绝对定位层包含块的既有约定） */
.back-bar {
  position: relative;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  height: 44px;
}
/* 返回箭头：字号 40px = 原大屏档值（466 档为 38px），等高盒 line-height/height 44px 不变 */
.back-btn {
  font-size: 40px;
  color: #ffffff;
  line-height: 44px;
  height: 44px;
}
/* 矩形屏单行导航（手表排版：左返回+标题、右时间）：默认隐藏，rect 档显示 */
.nav-bar {
  display: none;
}
.nav-title {
  font-size: 36px;
  color: #ffffff;
  font-weight: bold;
  lines: 1;
  text-overflow: ellipsis;
}
.nav-time {
  font-size: 34px;
  color: rgba(255, 255, 255, 0.6);
  lines: 1;
}
/* 品牌标题：与返回箭头同处一个 flex 行（margin-left 8px 与箭头拉开间距、两者靠拢），跟随组合整体居中；
   显式 height 44px + line-height 44px 与箭头等高盒，flex align-items: center 垂直居中对齐；
   margin-top 4px 为真机对齐补偿（引擎对 text 垂直定位有偏差，等高盒 + flex 居中后标题仍偏高，用 margin 下移补偿），
   如仍偏差可微调 2-6px；字号 34px = 原大屏档值（比顶部时钟 26px 大 8px），466 档为 32px；
   超长品牌名受 max-width 200px 限制，单行省略号兜底 */
.brand-title {
  margin-left: 8px;
  margin-top: 4px;
  max-width: 200px;
  font-size: 34px;
  color: #ffffff;
  font-weight: bold;
  line-height: 44px;
  height: 44px;
  lines: 1;
  text-overflow: ellipsis;
}
/* 顶部当前时间：line-height 48px 撑满时钟条垂直居中，无绝对定位；
   字号 26px = 原大屏档值，466 档为 24px */
.top-time {
  line-height: 48px;
  font-size: 26px;
  color: #ffffff;
  font-weight: bold;
  text-align: center;
  lines: 1;
  text-overflow: ellipsis;
}

/* 无数据兜底 */
.no-qr {
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding-top: 120px;
}

/* 圆屏(shape:circle，S3/S5 通用)：页面顶部 padding 已补安全区，因此调小自身顶部空距避免与返回按钮挤压 */
@media (shape: circle) {
  .no-qr {
    padding-top: 40px;
  }
}

/* 矩形屏（RW5/6、8·9·10Pro）的 no-qr 空距见文末「屏幕分档覆盖规则」块 */
.no-qr-main {
  font-size: 32px;
  color: #ffffff;
  font-weight: bold;
}
.no-qr-sub {
  font-size: 24px;
  color: #999999;
  margin-top: 16px;
}

/* 有二维码时的滚动容器：垂直滚动必须固定高度（Vela scroll 官方要求）。
   视口 y∈[92,480]：.page 顶部 padding 0 + clock-bar 48 + back-bar 44 = 92，
   高度 388px 顶满屏底；内容为标签/大码/二维码/时间（「已完成」按钮已移出 scroll 悬浮固定底部）；
   padding-bottom 96px 保留悬浮按钮占位空间：滚到底内容底屏幕 y = 92+388−96 = 384 < 按钮顶 391，
   留有 7px 间隙，时间文本不被悬浮按钮遮挡；首屏不受影响（内容 386 ≤ 388 首屏完整可见） */
.scroll {
  flex-direction: column;
  width: 100%;
  height: 388px;
  padding-bottom: 96px;
}

/* 内容容器：垂直排列，宽度 100% 不分形态收窄 */
.content {
  flex-direction: column;
  width: 100%;
}

/* 取餐码小字标签（居中）：字号 22px = 原大屏档值，466 档为 20px */
.code-label {
  font-size: 22px;
  color: #999999;
  text-align: center;
  height: 26px;
  line-height: 26px;
  lines: 1;
  text-overflow: ellipsis;
}
/* 大号取餐码数字：居中单行；字号 36px = 原大屏档值，466 档为 34px */
.code {
  font-size: 36px;
  color: #ffffff;
  font-weight: bold;
  text-align: center;
  margin-top: 4px;
  height: 46px;
  line-height: 46px;
  flex-shrink: 0;
  lines: 1;
  text-overflow: ellipsis;
}

/* 二维码区：白色圆角容器 .qr-base（border-radius 12px 常显占位）+
   直角白底 qrcode 缩小嵌套居中（circle 码 228/rect 码 204，白边 14/14px，码角不被圆角切到）；
   qrcode 组件不支持 border-radius（真机两次验证：16px 与照抄参考仓库 12px 均无圆角），
   圆角由 div 容器保证；qrcode 加 if 待数据就绪渲染，容器常显缓解双码闪烁；
   stack+transparent 曾致不渲染，勿用 */
.qr-wrap {
  flex-direction: column;
  justify-content: center;
  align-items: center;
  margin-top: 6px;
  height: 232px;
  flex-shrink: 0;
}
/* 白色圆角容器：常显（数据未就绪时即为白色圆角占位块，消除空 value 白直角块闪烁）；
   直角白底码（circle 228/rect 204）在其中居中，白边 14/14px ≥ 圆角 12px，码角不被圆角切到 */
.qr-base {
  flex-direction: column;
  justify-content: center;
  align-items: center;
  width: 232px;
  height: 232px;
  background-color: #ffffff;
  border-radius: 12px;
}
/* 直角码：qrcode 组件不支持 border-radius（真机两次验证：16px 与 12px 均无圆角），不设圆角；
   transparent 方案真机验证失败（二维码不渲染），已回退 #ffffff；
   码基础 204px（rect）：容器 232 白边 (232-204)/2 = 14px；circle 覆盖 228px：容器 256 白边 (256-228)/2 = 14px；
   两形态白边一致 14px ≥ 圆角 12px、码占容器比例一致；默认视图码底 circle 416/rect 392，与按钮顶 391 重叠 25px/1px（用户已知情）；
   白底由 .qr-base 圆角容器承担；码与 .qr-base 容器随页面整体进入动画一起出现，无独立淡入动画 */
.qr {
  width: 204px;
  height: 204px;
  color: #000000;
  background-color: #ffffff;
  margin: 0px;
}

/* 全屏二维码层：点击 .qr-base 进入（onQrClick），点击本层任意处关闭（onFullscreenClose）；
   绝对定位覆盖整屏（.page 为包含块），黑底；进入淡入动画 full-fade 0.2s；
   圆屏几何核算（圆心 240,240，半径 240；基档 480 屏 ×1.000 等比）：
   全屏容器 320×320 居中（中心 240,240，x∈[80,400]，y∈[80,400]）；
   底角 (80,400) 距圆心 √(160²+160²)≈226.3 < 240 在圆内；
   y=400 处弦 x∈[61,419] ⊃ 容器底边 [80,400] 完整可见；
   码 292 四周白边 14px ≥ 圆角 12px，码角不被切；
   rect 下 320 ≤ 内容宽 408 同样安全；
   亮度说明：全屏为页面内状态切换，不触发 onShow/onHide，亮度保持进入页面拉高的 75%，无需额外处理 */
.qr-fullscreen {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background-color: #000000;
  animation-name: full-fade;
  animation-duration: 0.2s;
  animation-timing-function: ease-out;
}
/* 全屏白底圆角大容器：320×320（圆屏内接圆边长 339 内留安全余量；rect 屏内容宽 408 亦容纳） */
.qr-full-base {
  flex-direction: column;
  justify-content: center;
  align-items: center;
  width: 320px;
  height: 320px;
  background-color: #ffffff;
  border-radius: 12px;
}
/* 全屏直角码：292×292 居中，码四周白边 (320-292)/2 = 14px ≥ 圆角 12px，码角不被切 */
.qr-full {
  width: 292px;
  height: 292px;
  background-color: #ffffff;
  margin: 0px;
}

/* 订单时间小字（YYYY-MM-DD HH:mm，来自 createdAt）：居中单行；
   字号 22px = 原大屏档值，466 档为 20px */
.time {
  font-size: 22px;
  color: #999999;
  text-align: center;
  margin-top: 20px;
  line-height: 28px;
  lines: 1;
  text-overflow: ellipsis;
}

/* 「已完成」按钮：悬浮固定页面底部中间（absolute 定位于 .page 底部 24px，不随 scroll 内容滚动）；
   按钮本体自适应宽度居中（横向 padding 40px，不全宽）、蓝色胶囊形；
   全屏层在模板最后绘制，z 序覆盖本按钮（全屏时按钮不可点，符合预期） */
.btn-wrap {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 24px;
  flex-direction: row;
  justify-content: center;
  align-items: center;
}
.done-btn {
  flex-direction: row;
  justify-content: center;
  align-items: center;
  height: 65px;
  padding: 0 40px;
  background-color: #0a84ff;
  border-radius: 40px;
}
/* 完成按钮文字：字号 26px = 原大屏档值，466 档为 24px */
.done-text {
  font-size: 26px;
  color: #ffffff;
  line-height: 44px;
  lines: 1;
}

/* ── 屏幕分档覆盖规则（置于基础样式之后，保证层叠生效）── */

/* 圆屏(shape:circle，S3 233dp / S5 240dp 通用)：忽略安全区；二维码容器 256×256、码 228×228（circle 覆盖值）。
   S3 上 ×0.971 等比：容器 248.6、码 221.4 物理，容器底角距圆心 √(155.4²+155.4²) ≈ 219.7 < 233 ✓、
   码四周白边 13.6 ≥ 圆角 11.7 ✓，scroll 高 376.7 = 466 − 46.6 − 42.7 ✓ —— 两圆屏几何同时安全，
   故 circle 档不拆分（原 480 几何核算保留，F 值 466 侧作等比验证）。
   圆屏几何核算（圆心 240,240，半径 240；基档 480 屏 ×1.000 等比）：
   顶部：clock-bar y∈[0,48]，26px 时钟居中宽约 65px（x≈[208,273]），
   y=8 处圆弦 x∈[179,301]，时钟完整可见；
   返回组合（箭头 + 品牌标题）整体水平居中：40px 箭头宽约 27px + 间距 8 + 标题 34px 字（2-4 字约 68-136px）
   → 组合宽约 103-171px，按最长 171px 居中 x∈[155,326]；长名 max-width 200px 时组合最宽约 235px → x∈[123,358]；
   y∈[48,92] 处弦最窄 x∈[96,384]（y=48），完整在弦内不裁切；rect 下同样安全；
   scroll 视口 y∈[92,480] 高 388px；内容 = 标签/大码/二维码/时间：
   内容总高 = 26 + (4+46) + (6+256) + (20+28) = 386 ≤ 388 视口，默认视图完整显示；
   码 228 在容器 256 中居中（白边 (256-228)/2 = 14px ≥ 圆角 12px）：码 y∈[188,416]，
   默认视图码底 416 与悬浮按钮顶 391 重叠 25px（用户已知情、接受）；
   时间 y∈[450,478]，默认视图下半部 6px（450..456）被按钮盖住（按钮底 456），滑到底后完整（见下）；
   按钮悬浮：bottom 24px + 高 65 → 屏幕 y∈[391,456]，x∈[164,316]（宽约 152 居中）；
   y=456 处弦 x∈[135,345] ⊃ 按钮底边，y=391 处弦 x∈[54,426] ⊃ 按钮顶边，完整不裁切；rect 下同样安全；
   scroll padding-bottom 96px 保留按钮占位空间：滚到底内容底屏幕 y = 92+388−96 = 384 < 按钮顶 391，7px 间隙；
   滚到底内容上移 94 → 时间 y∈[356,384]、码 y∈[108,322] 完整，时间与按钮间距 7px，不被遮挡；首屏不受影响（内容 386 ≤ 388）；
   全屏层在模板最后，z 序覆盖悬浮按钮（全屏时按钮不可点，符合预期）；
   容器 256 底边 y=430，底角 (112,430) 距圆心 √(128²+190²)≈229.1 < 240 在圆内（y=430 处弦 x∈[94,386]，容器 x∈[112,368] 完整可见）；
   码 228 居中，四周白边 14px ≥ 圆角 12px，码角不被切；
   rect 首屏 = 26+50+6+232 = 314 ≤ 388，富余 74px。 */
@media (shape: circle) {
  .scroll {
    height: 388px;
    padding-bottom: 96px;
  }
  .content {
    width: 100%;
    align-items: stretch;
  }
  .code {
    margin-top: 4px;
    font-size: 36px;
  }
  .time {
    margin-top: 20px;
  }
  .qr-wrap {
    height: 256px;
  }
  .qr-base {
    width: 256px;
    height: 256px;
  }
  .qr {
    width: 228px;
    height: 228px;
  }
}

/* rect432（RW5/RW6 216dp，×0.900）：方表设计 —— 容器/码按 432 宽重设，按钮贴底。
   几何核算（物理值 = 设计值 × 0.900）：
   垂直：时钟 45.9 + 返回 44.1 = 90，scroll 423.9 → 合计 513.9 ✓（屏高 514）；
   内容 = 25.2 + (3.6+45.9) + (6.3+216) + (19.8+27.9) = 344.7 ≤ 423.9，首屏完整 ✓；
   码容器 216 × 码 190.8：白边 12.6 ≥ 圆角 11.7 ✓，容器 ≤ 内容宽 360 ✓；
   滚到底（pb 96.3）内容底 417.6 < 按钮顶 424.9，间隙 7.3px，时间不被遮挡；
   按钮 y∈[424.9,489.7]，底 489.7 < 514 ✓ */
@media (shape: rect) and (min-width: 192) {
  .page {
    padding: 0px 40px 0px 40px;
  }
  .clock-bar {
    display: none;
  }
  .top-time {
    display: none;
  }
  .back-bar {
    display: none;
  }
  .nav-bar {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    height: 80px;
    padding-left: 34px;
    padding-right: 34px;
  }
  .nav-left {
    display: flex;
    flex-direction: row;
    align-items: center;
  }
  .nav-right {
    display: flex;
    flex-direction: row;
    align-items: center;
  }
  .nav-title {
    font-size: 36px;
    margin-left: 6px;
    line-height: 44px;
    margin-top: 4px;
  }
  .nav-time {
    font-size: 28px;
    margin-left: 14px;
  }
  .nav-back {
    font-size: 42px;
    color: #ffffff;
    margin-right: 6px;
    line-height: 44px;
  }
  /* 返回按钮（手环/方表思路）：‹ 圆形字符按钮（深灰圆底），与标题同行靠左（见 nav-bar 单行导航），
     不再与标题并排居中（圆表思路） */
  .back-btn {
    display: none;
  }
  .brand-title {
    margin-left: 0px;
    margin-top: 4px;
    max-width: 222px;
    font-size: 36px;
    line-height: 49px;
    height: 49px;
  }
  .no-qr {
    padding-top: 133px;
  }
  .no-qr-main {
    font-size: 36px;
  }
  .no-qr-sub {
    font-size: 27px;
    margin-top: 18px;
  }
  .scroll {
    height: 491px;
    padding-bottom: 107px;
  }
  .code-label {
    font-size: 24px;
    height: 28px;
    line-height: 28px;
  }
  .code {
    font-size: 40px;
    margin-top: 4px;
    height: 51px;
    line-height: 51px;
  }
  .qr-wrap {
    margin-top: 7px;
    height: 240px;
  }
  .qr-base {
    width: 240px;
    height: 240px;
    border-radius: 13px;
  }
  .qr {
    width: 212px;
    height: 212px;
  }
  .time {
    font-size: 24px;
    margin-top: 22px;
    line-height: 31px;
  }
  .btn-wrap {
    bottom: 27px;
  }
  .done-btn {
    height: 72px;
    padding: 0 44px;
    border-radius: 44px;
  }
  .done-text {
    font-size: 29px;
    line-height: 49px;
  }
  .qr-full-base {
    width: 356px;
    height: 356px;
    border-radius: 13px;
  }
  .qr-full {
    width: 328px;
    height: 328px;
  }
}

/* rect336（8Pro/9Pro/10Pro 168dp，×0.700）：手环设计（竖窄屏）—— 标题/返回按钮加大贴边、
   二维码容器按 336 宽重设（非 480 档缩放）。
   几何核算（物理值 = 设计值 × 0.700）：
   垂直：时钟 44.1 + 返回 44.1 = 88.2，scroll 392 → 合计 480.2 ✓（屏高 480）；
   内容 = 23.8 + (4.2+46.2) + (5.6+210) + (19.6+28) = 337.4 ≤ 392，首屏完整 ✓；
   码容器 210 × 码 184.8：白边 12.6 ≥ 圆角 11.9 ✓，容器 ≤ 内容宽 294 ✓；
   滚到底（pb 95.9）内容底 384.3 < 按钮顶 391.8，间隙 7.5px，时间不被遮挡；
   按钮 y∈[391.8,456.2]，底 456.2 < 480 ✓；全屏容器 284.2 ≤ 294、白边 11.2 = 圆角 11.2 ✓ */
@media (shape: rect) and (max-width: 192) {
  .page {
    padding: 0px 30px 0px 30px;
  }
  .clock-bar {
    display: none;
  }
  .top-time {
    display: none;
  }
  .back-bar {
    display: none;
  }
  .nav-bar {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    height: 103px;
    padding-left: 43px;
    padding-right: 43px;
  }
  .nav-left {
    display: flex;
    flex-direction: row;
    align-items: center;
  }
  .nav-right {
    display: flex;
    flex-direction: row;
    align-items: center;
  }
  .nav-title {
    font-size: 36px;
    margin-left: 6px;
    line-height: 56px;
    margin-top: 5px;
  }
  .nav-time {
    font-size: 34px;
    margin-left: 14px;
  }
  .nav-back {
    font-size: 54px;
    color: #ffffff;
    margin-right: 8px;
    line-height: 56px;
  }
  .back-btn {
    display: none;
  }
  .brand-title {
    margin-left: 0px;
    margin-top: 5px;
    max-width: 214px;
    font-size: 46px;
    line-height: 63px;
    height: 63px;
  }
  .no-qr {
    padding-top: 150px;
  }
  .no-qr-main {
    font-size: 37px;
  }
  .no-qr-sub {
    font-size: 29px;
    margin-top: 20px;
  }
  .scroll {
    height: 583px;
    padding-bottom: 137px;
  }
  .code-label {
    font-size: 30px;
    height: 34px;
    line-height: 34px;
  }
  .code {
    font-size: 51px;
    margin-top: 6px;
    height: 66px;
    line-height: 66px;
  }
  .qr-wrap {
    margin-top: 8px;
    height: 300px;
  }
  .qr-base {
    width: 300px;
    height: 300px;
    border-radius: 17px;
  }
  .qr {
    width: 264px;
    height: 264px;
  }
  .time {
    font-size: 30px;
    margin-top: 28px;
    line-height: 40px;
  }
  .btn-wrap {
    bottom: 34px;
  }
  .done-btn {
    height: 92px;
    padding: 0 56px;
    border-radius: 56px;
  }
  .done-text {
    font-size: 37px;
    line-height: 62px;
  }
  .qr-full-base {
    width: 406px;
    height: 406px;
    border-radius: 16px;
  }
  .qr-full {
    width: 374px;
    height: 374px;
  }
}

/* 页面跳转动画关键帧：
   page-in：进入动画，右侧滑入 48px + 透明度 0→1（0.25s ease-out，由 .page 触发，
   页面渲染即自动播放，无隐藏等待）
   page-out：退出动画，反向滑出（透明度 1→0 + 右移 48px，0.22s ease-in，由 .page-leaving 触发） */
@keyframes page-in {
  from {
    opacity: 0;
    transform: translateX(48px);
  }
  to {
    opacity: 1;
    transform: translateX(0px);
  }
}

@keyframes page-out {
  from {
    opacity: 1;
    transform: translateX(0px);
  }
  to {
    opacity: 0;
    transform: translateX(48px);
  }
}

/* 全屏二维码层淡入：opacity 0→1（0.2s ease-out，由 .qr-fullscreen 触发） */
@keyframes full-fade {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}
</style>

<script>
import router from "@system.router"
import brightness from "@system.brightness"

const BRIGHTNESS_BOOST = 191 // 二维码页拉高亮度：75% × 255

export default {
  private: {
    orderId: "",
    qrData: "",
    code: "",
    brandName: "",
    createdAt: 0,
    createdAtText: "",
    noQr: false,
    completedClicked: false,
    fullscreenQr: false, // 全屏二维码开关
    leaving: false, // 退出动画进行中标志（防重复点击）
    bypassBack: false, // 程序化 router.back() 前的放行标志，防止 onBackPress 误拦截造成循环
    backTimerId: null, // 退出动画播完延迟返回的定时器（220ms）
    lastVersion: -1,
    clockText: "",
    clockTimerId: null,
    pageActive: false, // 页面可见标志：onShow=true / onHide=false，抑制离页后的异步亮度设置
    brightnessApplied: false, // 已拉高亮度标志（还原后置 false，幂等）
    originalBrightness: -1, // 进入页面前的亮度值（0-255；-1=未记录），退出时还原
    originalBrightnessMode: -1 // 进入页面前的亮度模式（-1=未记录/读取失败，0=手动，1=自动），退出时还原
  },

  onInit() {
    const params = router.getParams()
    this.orderId = params && params.orderId ? params.orderId : ""
    this.completedClicked = false
  },

  onShow() {
    this.pageActive = true
    this.loadOrder()
    this.startWatcher() // 同步期间快照被 app 更新时刷新
    this.startClock() // 顶部当前时间：onShow 启动，onHide/onDestroy 停止
    this.boostBrightness() // 进入二维码页拉高亮度至 75%，退出时还原
  },

  onHide() {
    this.pageActive = false
    this.stopClock()
    this.restoreBrightness() // 离开页面还原亮度（幂等）
  },

  onDestroy() {
    this.stopWatcher()
    this.stopClock()
    this.restoreBrightness() // 兜底还原亮度（幂等，onHide 已还原则跳过）
    // 清理退出动画延迟返回定时器，防止页面销毁后定时器仍触发 router.back()
    if (this.backTimerId) {
      clearTimeout(this.backTimerId)
      this.backTimerId = null
    }
  },

  loadOrder() {
    const s = this.$app.$def.syncState
    if (!s) return
    const order = (s.snapshot.payload || []).find(function (it) {
      return it.orderId === this.orderId
    }, this)
    // 快照为唯一数据源：找不到订单即无数据，走 noQr 兜底 UI
    if (!order) {
      this.noQr = true
      return
    }
    this.qrData = order.qrCodeData || ""
    this.code = order.code || ""
    this.brandName = order.brandName || ""
    this.createdAt = order.createdAt || 0
    this.createdAtText = this.formatTime(this.createdAt)
    this.noQr = !this.qrData
    this.lastVersion = s.syncVersion
  },

  // 毫秒时间戳 → YYYY-MM-DD HH:mm（手动补零；Date 不可用则降级显示原始时间戳）
  formatTime(ts) {
    if (!ts) return ""
    try {
      const d = new Date(ts)
      if (typeof d.getFullYear !== "function" || isNaN(d.getTime())) {
        return String(ts)
      }
      const pad = function (n) {
        return (n < 10 ? "0" : "") + n
      }
      return (
        d.getFullYear() +
        "-" +
        pad(d.getMonth() + 1) +
        "-" +
        pad(d.getDate()) +
        " " +
        pad(d.getHours()) +
        ":" +
        pad(d.getMinutes())
      )
    } catch (e) {
      return String(ts)
    }
  },

  // 顶部当前时间时钟：JS Date 取 HH:mm，每 10 秒刷新一次
  startClock() {
    this.updateClock()
    if (this.clockTimerId) return
    let self = this
    this.clockTimerId = setInterval(function () {
      self.updateClock()
    }, 10000)
  },

  stopClock() {
    if (this.clockTimerId) {
      clearInterval(this.clockTimerId)
      this.clockTimerId = null
    }
  },

  // 用当前系统时间更新顶部时钟文本（HH:mm，手动补零；Date 不可用则显示空）
  updateClock() {
    try {
      const d = new Date()
      if (typeof d.getHours !== "function" || isNaN(d.getTime())) {
        this.clockText = ""
        return
      }
      const pad = function (n) {
        return (n < 10 ? "0" : "") + n
      }
      this.clockText = pad(d.getHours()) + ":" + pad(d.getMinutes())
    } catch (e) {
      this.clockText = ""
    }
  },

  startWatcher() {
    if (this.watcherId) return
    let self = this
    this.watcherId = setInterval(function () {
      const s = self.$app.$def.syncState
      if (s && s.syncVersion !== self.lastVersion) {
        self.loadOrder()
      }
    }, 600)
  },

  stopWatcher() {
    if (this.watcherId) {
      clearInterval(this.watcherId)
      this.watcherId = null
    }
  },

  // ── 亮度增强：进入二维码页拉高至 75%（191/255），离开时还原为进入前亮度 ──
  // 先记录亮度模式（自动 1 / 手动 0）：自动模式需先切手动，设置才生效，退出时一并还原模式；
  // 每个异步步骤都检查 pageActive，防止「秒进秒出」时回调链在页面离开后仍改动亮度
  boostBrightness() {
    if (this.brightnessApplied) return
    let self = this
    brightness.getMode({
      success: function (modeData) {
        if (!self.pageActive) return
        let mode = modeData && typeof modeData.mode === "number" ? modeData.mode : 0
        self.originalBrightnessMode = mode
        if (mode === 1) {
          // 自动亮度模式：先切手动再设置，退出时还原模式
          brightness.setMode({
            mode: 0,
            success: function () {
              self.applyBrightness()
            },
            fail: function () {
              self.applyBrightness()
            } // 切模式失败也继续尝试设置亮度
          })
        } else {
          self.applyBrightness()
        }
      },
      fail: function () {
        // 读模式失败：按手动处理，仅拉高亮度
        if (!self.pageActive) return
        self.originalBrightnessMode = -1
        self.applyBrightness()
      }
    })
  },

  // 记录原亮度并拉高至 75%；拿不到原值则不拉高（退出时无法还原，避免亮度被改乱）
  applyBrightness() {
    let self = this
    brightness.getValue({
      success: function (data) {
        if (!self.pageActive) return
        if (!data || typeof data.value !== "number") return
        self.originalBrightness = data.value
        self.brightnessApplied = true
        brightness.setValue({
          value: BRIGHTNESS_BOOST,
          success: function () {
            // 拉高完成时页面已离开：立即还原
            if (!self.pageActive) self.restoreBrightness()
          },
          fail: function () {
            self.brightnessApplied = false
            self.originalBrightness = -1
          }
        })
      },
      fail: function () {
        // 读不到原亮度：不拉高
      }
    })
  },

  // 还原亮度与模式（与拉高对称；幂等，onHide/onDestroy 均可调用）
  restoreBrightness() {
    if (!this.brightnessApplied) return
    this.brightnessApplied = false
    if (this.originalBrightness >= 0) {
      brightness.setValue({
        value: this.originalBrightness,
        fail: function () {}
      })
    }
    if (this.originalBrightnessMode === 1) {
      brightness.setMode({
        mode: 1,
        fail: function () {}
      })
    }
    this.originalBrightness = -1
    this.originalBrightnessMode = -1
  },

  // 返回：先播退出动画（0.22s），动画播完后由定时器（220ms，与动画时长对应）调 router.back()；
  // leaving 标志防重复点击；页面返回按钮与系统返回手势/按键均走退出动画（onBackPress 拦截后复用）
  onBack() {
    if (this.leaving) return
    this.leaving = true
    let self = this
    this.backTimerId = setTimeout(function () {
      self.backTimerId = null
      self.bypassBack = true
      router.back()
    }, 220)
  },

  // 系统返回键/返回手势拦截：全屏二维码打开时优先关闭全屏（不退出页面，也不播退出动画）；
  // 其余情况统一走退出动画链路（onBack 含防重复）；
  // return true 阻止引擎默认立即返回；程序化 router.back() 前已置 bypassBack 放行（return false）
  onBackPress() {
    if (this.bypassBack) return false
    if (this.fullscreenQr) {
      this.fullscreenQr = false
      return true
    }
    this.onBack()
    return true
  },

  // 点击二维码：打开全屏二维码
  onQrClick() {
    this.fullscreenQr = true
  },

  // 点击全屏层任意处：关闭全屏二维码
  onFullscreenClose() {
    this.fullscreenQr = false
  },

  // 标记已完成：发 done 回执（幂等）后返回列表；标志位防重复点击
  onMarkCompleted() {
    if (this.completedClicked) return
    this.completedClicked = true
    this.$app.$def.markDone(this.orderId)
    router.back()
  }
}
</script>
