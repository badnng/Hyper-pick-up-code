<template>
  <!-- 开屏页（manifest entry 指向本页，冷启动先于任何主页加载）：
       独立开屏页面；启动时读取设备逻辑宽高，让根节点按实际 viewport 尺寸铺满并用 flex 居中；
       brand 子容器显式 column 居中 logo（logo 140×140，项目无标题故省略 title）；
       logo 静止停留：device.getInfo 判定设备分组（466x466/480x480，3s 定时器兜底），
       判定完成即 router.replace 进入对应分辨率档主页（淡出动画移至主页 onReady 后播放，
       由主页启动遮罩无缝衔接本页黑底 + logo） -->
  <div class="background" style="width: {{viewportWidth}}px; height: {{viewportHeight}}px;">
    <div class="logobox">
      <image class="logo" src="/common/logo.png"></image>
    </div>
    
  </div>
</template>

<style>
/* 开屏根节点：按 device.getInfo 返回的实际宽高覆盖 viewport，内部使用 flex 双向居中 */
.background {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: unset;
  background-color: #000000;
  align-items: center;
  justify-content: center;
}

/* 子容器：照抄 rpk1 .brand（144×201 含 logo+title），本项目无标题，仅包 logo；
   Vela 默认 flex-direction: row，故显式 column + align-items: center 让 logo 水平居中；
   justify-content: center 让 logo 垂直居中（column 主轴），与 align-items: center 组成双向居中兜底——
   即使 image 按 PNG 固有 100×100 渲染（width/height 未生效），logo 在 140×140 容器内仍居中不贴顶 */
  .logobox{
    align-items: center;
    justify-content: center;
  }

/* App 图标：140×140（与桌面图标共用 /common/logo.png，安卓式 splash） */
.logo {
  width: 140px;
  height: 140px;
}
</style>

<script>
import router from '@system.router'
import device from '@system.device'

export default {
  private: {
    groupReady: false,
    targetGroup: '480x480',
    replaced: false,
    deviceTimerId: null,
    viewportWidth: 480,
    viewportHeight: 480
  },

  onInit() {
    // 设备分组判定（照抄 rpk1 welcome_logo_new：device.getInfo 分发 replace）；
    // logo 静止停留：分组判定完成即 replace 进主页，淡出动画移至主页 onReady 后播放
    this.checkDevice()
  },

  // 设备分组判定（照抄 rpk1：success/fail/complete 收敛 + done 标志 + 3s 兜底）
  checkDevice() {
    let self = this
    let done = false
    let finish = function (info) {
      if (done) return
      done = true
      if (self.deviceTimerId) {
        clearTimeout(self.deviceTimerId)
        self.deviceTimerId = null
      }
      info = info || {}
      // 用真机实际逻辑屏幕尺寸铺满遮罩，避免仅按固定 480 档居中
      let width = Number(info.screenWidth)
      let height = Number(info.screenHeight)
      if (width > 0) self.viewportWidth = width
      if (height > 0) self.viewportHeight = height
      // 实测屏幕尺寸写入 $def（仅合法正值才写入），供 index 主页启动遮罩铺满
      self.$app.$def.setViewport(width, height)
      self.targetGroup = (width === 466 && height === 466) ? '466x466' : '480x480'
      self.$app.$def.setDeviceGroup(self.targetGroup)
      self.groupReady = true
      self.attemptJump()
    }
    this.deviceTimerId = setTimeout(function () { finish({}) }, 3000)
    device.getInfo({
      success: function (res) { finish(res) },
      fail: function () { finish({}) },
      complete: function (res) { finish(res) }
    })
  },

  // 分组已确定即跳转（无 1.2s 停留与 0.3s 淡出：logo 静止停留，淡出动画移至主页 onReady 后）
  attemptJump() {
    if (this.replaced || !this.groupReady) return
    this.replaced = true
    let self = this
    router.replace({
      uri: '/pages/' + this.targetGroup + '/index',
      fail: function () {
        self.replaced = false
        router.replace({ uri: '/pages/' + self.targetGroup + '/index' })
      }
    })
  },

  onDestroy() {
    if (this.deviceTimerId) { clearTimeout(this.deviceTimerId); this.deviceTimerId = null }
  }
}
</script>
