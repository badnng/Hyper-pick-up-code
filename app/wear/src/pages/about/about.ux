<script>
import router from "@system.router"
import app from "@system.app"

export default {
  private: {
    clockText: "",
    versionText: "",
    clockTimerId: null,
    backTimerId: null,
    leaving: false,
    bypassBack: false
  },

  onShow() {
    this.loadVersion()
    this.updateClock()
    if (!this.clockTimerId) {
      let self = this
      this.clockTimerId = setInterval(function () {
        self.updateClock()
      }, 10000)
    }
  },

  onHide() {
    this.stopClock()
  },

  onDestroy() {
    this.stopClock()
    if (this.backTimerId) {
      clearTimeout(this.backTimerId)
      this.backTimerId = null
    }
  },

  loadVersion() {
    try {
      this.versionText = app.getInfo().versionName
    } catch (e) {
      this.versionText = "未知"
    }
  },

  updateClock() {
    try {
      const d = new Date()
      const pad = function (n) {
        return (n < 10 ? "0" : "") + n
      }
      this.clockText = pad(d.getHours()) + ":" + pad(d.getMinutes())
    } catch (e) {
      this.clockText = ""
    }
  },

  stopClock() {
    if (this.clockTimerId) {
      clearInterval(this.clockTimerId)
      this.clockTimerId = null
    }
  },

  onBack() {
    if (this.leaving) return
    this.leaving = true
    let self = this
    this.backTimerId = setTimeout(function () {
      self.backTimerId = null
      self.bypassBack = true
      router.back()
    }, 220)
  },

  onBackPress() {
    if (this.bypassBack) return false
    this.onBack()
    return true
  }
}
</script>
