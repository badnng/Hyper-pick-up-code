  "code_extraction": {
    "express": {
      "trigger_keywords": [
        "取件码",
        "取性码",
        "请凭",
        "靖凭"
      ],
      "patterns": [
        {
          "id": "express_3segment",
          "regex": "([A-Z0-9]+-[A-Z0-9]+-[A-Z0-9]+)",
          "priority": 1,
          "description": "三段式连字符（A-2-7261）",
          "weight_multiplier": 20
        },
        {
          "id": "express_A3-B1-C4",
          "regex": "([A-Z0-9]+-[A-Z0-9]+-[A-Z0-9]+)",
          "priority": 2,
          "description": "123-1-1234类型",
          "weight_multiplier": 20

        },
        {
          "id": "express_2segment",
          "regex": "([A-Z]{1,3}[0-9]{0,3}-[0-9]{3,8}|[A-Z0-9]{1,4}-[A-Z0-9]{3,8})",
          "priority": 2,
          "description": "两段式连字符（ZT-20001）",
          "weight_multiplier": 20
        },
        {
          "id": "express_pure_number",
          "regex": "(?<![0-9])([0-9]{4,8})(?![0-9])",
          "priority": 3,
          "description": "纯数字 4-8 位（39359）",
          "weight_multiplier": 1
        },
        {
          "id": "express_alphanum",
          "regex": "([A-Z]{1,3}[0-9]{4,8}|[A-Z][0-9]{6,10})",
          "priority": 4,
          "description": "字母数字混合（ZT20001）",
          "weight_multiplier": 5
        },
        {
          "id": "express_generic",
          "regex": "([A-Z0-9-]{3,12})",
          "priority": 5,
          "description": "通用模式",
          "weight_multiplier": 1
        }
      ],
      "fallback_pattern": {
        "regex": "(?<![a-zA-Z0-9-])([0-9]{4,8}|[A-Z0-9]+-[A-Z0-9]+-[A-Z0-9]+|[A-Z]{1,3}[0-9]{0,3}-[0-9]{3,8}|[A-Z0-9]{1,4}-[A-Z0-9]{3,8}|[A-Z]{1,3}[0-9]{4,8}|[A-Z][0-9]{6,10}|[A-Z0-9][A-Z0-9-]{2,11})(?![a-zA-Z0-9-])",
        "requires_trigger": true
      }
    },
    "food": {
