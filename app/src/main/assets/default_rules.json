      ],
      "generic_code_pattern": "[A-Z0-9]{3,10}",
      "standalone_code_pattern": "^[A-Z0-9]{3,10}$",
      "queue_keywords": [
        "叫号",
        "取号",
        "过号",
        "排队",
        "迎宾台",
        "到店就餐",
        "还需等待",
        "桌安排",
        "预约号码",
        "卡座",
        "排号",
        "取餐号"
      ],
      "queue_threshold": 2,
      "patterns": {
        "queue_patterns": [
          {
            "id": "queue_desk_code",
            "regex": "(小桌|中桌|大桌|)\\s*([A-Z]{1,2}\\d{1,3}|\\d{1,3}[A-Z]{1,2})",
            "description": "桌型+码（小桌A3）",
            "code_length_min": 2,
            "code_length_max": 5,
            "require_mixed": true
          },
          {
            "id": "queue_plain_code",
            "regex": "([A-Z]{1,2}\\d{1,3}|\\d{1,3}[A-Z]{1,2})(?=[A-Z]{0,2}号|\\s*(?:号|桌|台|单))",
            "description": "纯号位码（A3号）",
            "code_length_min": 2,
            "code_length_max": 5,
            "require_mixed": true
          },
          {
            "id": "queue_desk_code_1234",
            "regex": "([0-9]{4})",
            "description": "四位纯数字排队号（取号7090）",
            "code_length_min": 4,
            "code_length_max": 4,
            "require_mixed": false
          }
        ],
        "slogan_pattern": {
          "id": "slogan_code",
          "regex": "([A-Z][A-Z0-9]{2,9}[.．][\\u4e00-\\u9fa5A-Za-z0-9]{2,24})",
          "priority": 1,
          "description": "口令型（M707.你的脚步有力量）",
          "weight_multiplier": 1
        },
        "hash_code_pattern": {
          "id": "hash_code",
          "regex": "#([0-9]{3,10})",
          "priority": 1,
          "description": "匹配 # 开头的取餐码（如 #2017）",
          "weight_multiplier": 10
        },
        "keyword_pattern": {
          "id": "keyword_code",
          "forward_regex": "(?:制作中|取单码|取单号|取餐号|取餐码|取茶号|取货码|券码|订单号|取性码|取養号|取茶码)[:：]?.*?(?:#)?([A-Z0-9]{3,10})",
          "reverse_regex": "(?:#)?([A-Z0-9]{3,10})[:：]?.*?(?:取单码|取单号|取餐号|取餐码|取茶号|取货码|券码|订单号|取性码|取養号|取茶码)"
        },
        "fallback_pattern": {
          "id": "food_fallback",
          "regex": "(?<![a-zA-Z0-9])(?<![Nn][Oo][.．:：\\s])(?<![Nn][Oo][.．:：]\\s)([A-Z0-9]{3,10})(?![a-zA-Z0-9])",
          "priority": 5,
          "description": "全文兜底（排除 NO. 门店编号）",
          "weight_multiplier": 1
        }
      },
      "starbucks_pattern": {
        "regex": "(\\d{1,3}[.．][\\u4e00-\\u9fa5]{2,10})",
        "trigger_keywords": [
          "啡快口令"
        ],
        "trigger_brand": "星巴克",
        "description": "星巴克啡快口令（17.超常发挥）"
      },
      "nearby_block_distance": 400,
      "keyword_context_range": 6,
      "short_code_length": 3
    }
